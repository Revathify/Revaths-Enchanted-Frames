package-as: RevathsEnchantedFrames-Package
enable-nolib-creation: no

# CurseForge stages the repository under package-as. Move each active addon
# to the ZIP root so WoW can find its TOC directly inside Interface/AddOns.
move-folders:
  RevathsEnchantedFrames-Package/RevathsEnchantedFrames: RevathsEnchantedFrames
  RevathsEnchantedFrames-Package/RevathsMailbox: RevathsMailbox
  RevathsEnchantedFrames-Package/RevathsMacro: RevathsMacro
  RevathsEnchantedFrames-Package/RevathsMailboxTooltipHelper: RevathsMailboxTooltipHelper
  RevathsEnchantedFrames-Package/RevathsWeeklyPlanner: RevathsWeeklyPlanner
  RevathsEnchantedFrames-Package/RevathsWhispers: RevathsWhispers

ignore:
  - AGENTS.md
  - CHANGELOG.md
  - Jenkinsfile
  - README.md
  - WEBSITE_DESCRIPTION.md
  - RevathsAuctionHouse
  - artifacts
  - docs
  - scripts
  - tests
  - tools
